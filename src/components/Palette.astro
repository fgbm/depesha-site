<!-- ============ KEYBOARD ============ -->
<section class="kb grain">
  <div class="wrap kb-grid">
    <div class="palette rv" aria-hidden="true">
      <div class="q">
        <svg viewBox="0 0 24 24"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg
        ><span class="typed" id="typed"></span><span class="caret"></span><span class="k">Ctrl+K</span>
      </div>
      <ul id="results"></ul>
    </div>
    <div>
      <h2 class="sec-title rv">Пара букв&nbsp;— <em>и готово</em></h2>
      <p class="sec-lede rv">
        <span class="kbd">Ctrl</span> <span class="kbd">K</span> открывает палитру: наберите начало
        слова и выполните любое действие или перейдите в любую папку. Поиск понимает русский язык и
        уточнения.
      </p>
      <div class="ops rv">
        <code><b>от:</b>Сидоров</code><code><b>есть:</b>вложение</code><code><b>после:</b>01.09</code
        ><code><b>больше:</b>25М</code><code><b>в:</b>Работа/*</code><code><b>год:</b>2024</code>
      </div>
    </div>
  </div>
</section>

<script>
  /* Палитра команд Ctrl+K в разделе «Пара букв — и готово». */
  (() => {
    const typed = document.getElementById('typed');
    const results = document.getElementById('results');
    if (!typed || !results) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const I: Record<string, string> = {
      clock: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/>',
      folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
      mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
      clip: '<path d="m21 11-8.5 8.5a5 5 0 0 1-7-7L14 4a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 7"/>',
    };
    const SCENES: { q: [string, string?][]; items: [string, string, string][] }[] = [
      {
        q: [['отл']],
        items: [
          ['clock', '<mark>Отл</mark>ожить до вечера', '18:00'],
          ['clock', '<mark>Отл</mark>ожить до утра', '9:00'],
          ['clock', '<mark>Отл</mark>ожить до понедельника', 'пн 9:00'],
          ['folder', 'Перейти в «<mark>Отл</mark>оженные»', 'папка'],
        ],
      },
      {
        q: [['от:', 'op'], ['Сидоров '], ['есть:', 'op'], ['вложение']],
        items: [
          ['clip', 'Re: Смета на монтаж', 'пн'],
          ['clip', 'Смета, вторая редакция', '12 сен'],
          ['clip', 'Акт выполненных работ', '30 авг'],
        ],
      },
      {
        q: [['смет']],
        items: [
          ['folder', 'Папка «<mark>Смет</mark>ы»', 'Работа'],
          ['mail', 'Письма с темой «<mark>смет</mark>а»', '14'],
          ['mail', 'Искать «<mark>смет</mark>» на сервере', 'архив'],
        ],
      },
    ];
    let si = 0;
    function playPalette() {
      const S = SCENES[si++ % SCENES.length]!;
      const full = S.q.map((p) => p[0]).join('');
      let n = 0;
      typed!.innerHTML = '';
      results!.innerHTML = '';
      const typeStep = () => {
        n++;
        let left = n;
        let html = '';
        for (const [txt, cls] of S.q) {
          const part = txt.slice(0, Math.max(0, left));
          left -= txt.length;
          if (part) html += cls ? `<span class="${cls}">${part}</span>` : part;
        }
        typed!.innerHTML = html;
        if (n < full.length) setTimeout(typeStep, 85 + Math.random() * 70);
        else {
          results!.innerHTML = S.items
            .map(
              ([ic, t, tail], i) =>
                `<li style="animation-delay:${i * 70}ms"><span class="ic"><svg viewBox="0 0 24 24">${I[ic]}</svg></span><span>${t}</span><span class="tail">${tail}</span></li>`,
            )
            .join('');
          const lis = results!.querySelectorAll('li');
          let j = 0;
          const sel = () => {
            lis.forEach((l, x) => l.classList.toggle('sel', x === j));
          };
          sel();
          const iv = setInterval(() => {
            j = Math.min(j + 1, lis.length - 1);
            sel();
          }, 700);
          setTimeout(() => {
            clearInterval(iv);
            playPalette();
          }, 3600);
        }
      };
      setTimeout(typeStep, 500);
    }
    if (!reduce) playPalette();
    else typed.textContent = 'отл';
  })();
</script>
