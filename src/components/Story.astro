</section>

<script>
  /* Разделы ниже первого экрана: сцены приложения меняются по мере прокрутки. */
  (() => {
    const app = document.getElementById('app');
    if (!app) return;
    const steps = document.querySelectorAll('.step');
    const usec = document.getElementById('usec');
    const sio = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          steps.forEach((s) => s.classList.toggle('on', s === e.target));
          const target = e.target as HTMLElement;
          if (app.dataset.s !== target.dataset.s) {
            app.dataset.s = target.dataset.s;
            app
              .querySelectorAll('.scene,.row,.pop,.compose,.undo,.arrive,.snz-note,.dlg li')
              .forEach((n) => {
                const el = n as HTMLElement;
                el.style.animation = 'none';
                void el.offsetWidth;
                el.style.animation = '';
              });
            t0 = performance.now();
          }
        }),
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => sio.observe(s));
    steps[0]?.classList.add('on');
    let t0 = performance.now();
    (function tickUndo(now: number) {
      if (usec && app.dataset.s === 'undo') {
        const p = ((now - t0) % 7000) / 7000;
        const v = p < 0.38 ? 10 : p > 0.92 ? 0 : Math.ceil(10 - ((p - 0.38) / 0.54) * 10);
        if (usec.textContent != String(v)) usec.textContent = String(v);
      }
      requestAnimationFrame(tickUndo);
    })(t0);
  })();
</script>
