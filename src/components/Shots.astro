---
import { Picture } from 'astro:assets';
import compose from '../../assets/screenshots/compose.png';
import dark from '../../assets/screenshots/dark.png';
import followups from '../../assets/screenshots/followups.png';
import meeting from '../../assets/screenshots/meeting.png';
import palette from '../../assets/screenshots/palette.png';
import snooze from '../../assets/screenshots/snooze.png';

interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;

const shots =
  lang === 'en'
    ? [
        {
          src: compose,
          alt: 'The compose window: recipients as chips, the formatting row, the file and send buttons.',
          caption: 'A new letter: formatting, files and the check before sending.',
        },
        {
          src: snooze,
          alt: 'A letter in the list with the snooze menu open above it: later today, tomorrow morning, next week.',
          caption: 'Snooze: this evening, tomorrow morning, next week or the time you pick.',
        },
        {
          src: followups,
          alt: 'The “Waiting for reply” list with the letter open and its panel: waiting since Monday, reminds on Saturday.',
          caption: 'Waiting for reply: whom you wrote to and who has not answered yet.',
        },
        {
          src: meeting,
          alt: 'A calendar invitation in the reader as a card: title, time, place, organiser and the participants’ answers.',
          caption: 'A calendar invitation reads as a card: time, place, participants.',
        },
        {
          src: palette,
          alt: 'The command palette over the window: a search field and the list of commands with their keys.',
          caption: 'Ctrl+K: any action or any folder by the first letters.',
        },
        {
          src: dark,
          alt: 'The same window in the dark “Ink” look: a dark list, a dark reader, a light letter body.',
          caption: 'The dark “Ink” look.',
        },
      ]
    : [
        {
          src: compose,
          alt: 'Окно нового письма: адресаты плашками, строка форматирования, кнопки файлов и отправки.',
          caption: 'Новое письмо: форматирование, файлы и проверка перед отправкой.',
        },
        {
          src: snooze,
          alt: 'Письмо в списке с открытым меню «Отложить»: вечером, завтра, эти выходные, следующая неделя.',
          caption: 'Отложить: вечером, завтра утром, на следующей неделе или когда скажете.',
        },
        {
          src: followups,
          alt: 'Раздел «Ждут ответа»: письмо открыто, над ним панель ожидания — ждём с понедельника, напомним в субботу.',
          caption: 'Ждут ответа: кому вы писали и кто ещё не ответил.',
        },
        {
          src: meeting,
          alt: 'Приглашение в календарь в читалке карточкой: название, время, место, организатор и ответы участников.',
          caption: 'Приглашение в календарь — карточкой: время, место, участники.',
        },
        {
          src: palette,
          alt: 'Палитра команд над окном: поле поиска и список команд с их клавишами.',
          caption: 'Ctrl+K: любое действие или папка по началу слова.',
        },
        {
          src: dark,
          alt: 'То же окно в тёмной теме «Чернила»: тёмная боковая панель, тёмный список, светлое тело письма.',
          caption: 'Тёмная тема «Чернила».',
        },
      ];
---

<!-- ============ SCREENSHOTS ============ -->
<section class="shots grain" id="shots">
  <div class="wrap">
    <h2 class="sec-title rv">
      {lang === 'en' ? <>The app, <em>screen by screen</em></> : <>Приложение <em>экранами</em></>}
    </h2>
    <p class="sec-lede rv">
      {
        lang === 'en'
          ? 'Screens of the released app 0.8.13, taken on a test mailbox. The mail is a demo one: names and addresses are invented.'
          : 'Снимки выпущенного приложения 0.8.13 на тестовом ящике. Почта демонстрационная: имена и адреса выдуманы.'
      }
    </p>
    <div class="shots-grid">
      {
        shots.map((s) => (
          <figure class="rv">
            <div class="shot-frame">
              <Picture
                src={s.src}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[560, 840, 1280]}
                sizes="(max-width: 900px) 92vw, 560px"
                alt={s.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
