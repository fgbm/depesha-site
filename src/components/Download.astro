---
import type { Downloads } from '../lib/releases';
import { pick } from '../lib/releases';

interface Props {
  downloads: Downloads;
}

const { downloads } = Astro.props;
const linuxHref = pick(downloads.linux.appimage, downloads.linux.deb, downloads.linux.rpm);
const winHref = pick(downloads.windows.msi, downloads.windows.exe);
const macHref = pick(downloads.mac.arm, downloads.mac.x64);
const version = downloads.version;
---

<!-- ============ DOWNLOAD ============ -->
<section class="dl grain" id="download">
  <div class="wrap">
    <img class="seal-big rv" src="/logo/depesha.svg" alt="" />
    <h2 class="rv">Разберите почту <em>сегодня</em></h2>
    <p class="sub rv">
      Бесплатно, с открытым кодом. Сама следит за новыми версиями, каждое обновление подписано.
    </p>
    <div class="oses rv">
      <a class="os-card" data-os="linux" href={linuxHref}
        ><span class="here">ваша система</span><h4>Linux</h4><p>.deb · .rpm · AppImage</p></a
      >
      <a class="os-card" data-os="win" href={winHref}
        ><span class="here">ваша система</span><h4>Windows</h4><p>.msi</p></a
      >
      <a
        class="os-card"
        data-os="mac"
        href={macHref}
        data-arm={downloads.mac.arm ?? ''}
        data-x64={downloads.mac.x64 ?? ''}
        ><span class="here">ваша система</span><h4>macOS</h4><p>.dmg</p></a
      >
    </div>
    {version && <p class="version rv">Версия {version}</p>}
    <p class="warn rv">
      Сборки пока не подписаны сертификатом разработчика, поэтому при первом запуске Windows и macOS
      предупредят о неизвестном издателе.
    </p>
  </div>
</section>

<script>
  /* Определение системы посетителя: подпись кнопок, подсветка карточки и прямая ссылка. */
  (() => {
    const ua = navigator.userAgent;
    const os = /Windows/.test(ua) ? 'win' : /Mac/.test(ua) ? 'mac' : 'linux';
    const na = navigator as Navigator & { userAgentData?: { architecture?: string } };
    const arm = na.userAgentData?.architecture === 'arm';

    const nameEl = document.querySelector('.os-name');
    if (nameEl) nameEl.textContent = { win: 'Windows', mac: 'macOS', linux: 'Linux' }[os]!;

    const card = document.querySelector<HTMLAnchorElement>(`.os-card[data-os="${os}"]`);
    if (card) card.classList.add('me');

    const macCard = document.querySelector<HTMLAnchorElement>('.os-card[data-os="mac"]');
    if (macCard) {
      const url = (arm ? macCard.dataset.arm : macCard.dataset.x64) || macCard.dataset.x64;
      if (url) macCard.href = url;
    }

    const cta = document.getElementById('cta-main');
    if (cta) {
      const url =
        os === 'win' ? cta.dataset.win : os === 'mac' ? (arm ? cta.dataset.macArm : cta.dataset.macX64) : cta.dataset.linux;
      if (url) cta.setAttribute('href', url);
    }
  })();
</script>
