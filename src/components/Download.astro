---
import type { Downloads } from '../lib/releases';
import { pick } from '../lib/releases';

interface Props {
  downloads: Downloads;
}

const { downloads } = Astro.props;
const version = downloads.version;
const linux = [
  { label: 'AppImage', fmt: 'appimage', href: pick(downloads.linux.appimage) },
  { label: '.deb', fmt: 'deb', href: pick(downloads.linux.deb) },
  { label: '.rpm', fmt: 'rpm', href: pick(downloads.linux.rpm) },
];
const windows = [
  { label: '.msi', fmt: 'msi', href: pick(downloads.windows.msi) },
  ...(downloads.windows.exe ? [{ label: '.exe', fmt: 'exe', href: downloads.windows.exe }] : []),
];
const mac = [
  { label: 'Apple Silicon', fmt: 'arm', href: pick(downloads.mac.arm) },
  { label: 'Intel', fmt: 'x64', href: pick(downloads.mac.x64) },
];
---

<!-- ============ DOWNLOAD ============ -->
<section class="dl grain" id="download">
  <div class="wrap">
    <img class="seal-big rv" src="/logo/depesha.svg" alt="" />
    <h2 class="rv">Разберите почту <em>сегодня</em></h2>
    <p class="sub rv">
      Бесплатно, с открытым кодом. Сама следит за новыми версиями, каждое обновление подписано.
    </p>
    <div class="oses rv">
      <div class="os-card" data-os="linux">
        <span class="here">ваша система</span>
        <h4>Linux</h4>
        <div class="fmts">
          {linux.map((f) => <a href={f.href} data-fmt={f.fmt}>{f.label}</a>)}
        </div>
      </div>
      <div class="os-card" data-os="win">
        <span class="here">ваша система</span>
        <h4>Windows</h4>
        <div class="fmts">
          {windows.map((f) => <a href={f.href} data-fmt={f.fmt}>{f.label}</a>)}
        </div>
      </div>
      <div class="os-card" data-os="mac">
        <span class="here">ваша система</span>
        <h4>macOS</h4>
        <div class="fmts">
          {mac.map((f) => <a href={f.href} data-fmt={f.fmt}>{f.label}</a>)}
        </div>
      </div>
    </div>
    <p class="version rv" data-version={version ?? ''} hidden={!version}>{version && `Версия ${version}`}</p>
    <p class="warn rv">
      Сборки пока не подписаны сертификатом разработчика, поэтому при первом запуске Windows и macOS
      предупредят о неизвестном издателе.
    </p>
  </div>
</section>

<script>
  /* Определение системы посетителя: подсветка карточки и прямая ссылка главной
     кнопки. Затем — свежая версия и ссылки на файлы прямо из GitHub. */
  import { detectOs, chooseUrl } from '../lib/os';
  import { initLiveRelease } from '../scripts/live-release';

  (() => {
    const { os, arm } = detectOs();

    const nameEl = document.querySelector('.os-name');
    if (nameEl) nameEl.textContent = { win: 'Windows', mac: 'macOS', linux: 'Linux' }[os]!;

    const card = document.querySelector(`.os-card[data-os="${os}"]`);
    if (card) card.classList.add('me');

    const cta = document.getElementById('cta-main') as HTMLAnchorElement | null;
    if (cta) {
      const url = chooseUrl(os, arm, {
        linux: cta.dataset.linux ?? '',
        win: cta.dataset.win ?? '',
        macArm: cta.dataset.macArm ?? '',
        macX64: cta.dataset.macX64 ?? '',
      });
      if (url) cta.setAttribute('href', url);
    }
  })();

  initLiveRelease();
</script>
