---
import type { Downloads } from '../lib/releases';
import { pick } from '../lib/releases';

interface Props {
  downloads: Downloads;
}

const { downloads } = Astro.props;
const version = downloads.version;
const linux = [
  { label: 'AppImage', href: pick(downloads.linux.appimage) },
  { label: '.deb', href: pick(downloads.linux.deb) },
  { label: '.rpm', href: pick(downloads.linux.rpm) },
];
const windows = [
  { label: '.msi', href: pick(downloads.windows.msi) },
  ...(downloads.windows.exe ? [{ label: '.exe', href: downloads.windows.exe }] : []),
];
const mac = [
  { label: 'Apple Silicon', href: pick(downloads.mac.arm) },
  { label: 'Intel', href: pick(downloads.mac.x64) },
];
---

<!-- ============ DOWNLOAD ============ -->
<section class="dl grain" id="download">
  <div class="wrap">
    <img class="seal-big rv" src="/logo/depesha.svg" alt="" />
    <h2 class="rv">Разберите почту <em>сегодня</em></h2>
    <p class="sub rv">
      Бесплатно, с открытым кодом. Сама следит за новыми версиями, каждое обновление подписано.
    </p>
    <div class="oses rv">
      <div class="os-card" data-os="linux">
        <span class="here">ваша система</span>
        <h4>Linux</h4>
        <div class="fmts">
          {linux.map((f) => <a href={f.href}>{f.label}</a>)}
        </div>
      </div>
      <div class="os-card" data-os="win">
        <span class="here">ваша система</span>
        <h4>Windows</h4>
        <div class="fmts">
          {windows.map((f) => <a href={f.href}>{f.label}</a>)}
        </div>
      </div>
      <div class="os-card" data-os="mac">
        <span class="here">ваша система</span>
        <h4>macOS</h4>
        <div class="fmts">
          {mac.map((f) => <a href={f.href}>{f.label}</a>)}
        </div>
      </div>
    </div>
    {version && <p class="version rv">Версия {version}</p>}
    <p class="warn rv">
      Сборки пока не подписаны сертификатом разработчика, поэтому при первом запуске Windows и macOS
      предупредят о неизвестном издателе.
    </p>
  </div>
</section>

<script>
  /* Определение системы посетителя: подсветка карточки и прямая ссылка главной кнопки. */
  (() => {
    const ua = navigator.userAgent;
    const os = /Windows/.test(ua) ? 'win' : /Mac/.test(ua) ? 'mac' : 'linux';
    const na = navigator as Navigator & { userAgentData?: { architecture?: string } };
    const arm = na.userAgentData?.architecture === 'arm';

    const nameEl = document.querySelector('.os-name');
    if (nameEl) nameEl.textContent = { win: 'Windows', mac: 'macOS', linux: 'Linux' }[os]!;

    const card = document.querySelector(`.os-card[data-os="${os}"]`);
    if (card) card.classList.add('me');

    const cta = document.getElementById('cta-main');
    if (cta) {
      const url =
        os === 'win' ? cta.dataset.win : os === 'mac' ? (arm ? cta.dataset.macArm : cta.dataset.macX64) : cta.dataset.linux;
      if (url) cta.setAttribute('href', url);
    }
  })();
</script>
