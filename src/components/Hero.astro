---
import { Picture } from 'astro:assets';
import mainShot from '../../assets/screenshots/main.png';
import type { Downloads } from '../lib/releases';

interface Props {
  downloads: Downloads;
}

const { downloads } = Astro.props;
const ver = downloads.version ? ` ${downloads.version}` : '';
const linux = downloads.linux.appimage ?? downloads.linux.deb ?? '';
const win = downloads.windows.msi ?? downloads.windows.exe ?? '';
const macArm = downloads.mac.arm ?? '';
const macX64 = downloads.mac.x64 ?? '';
---

<!-- ============ HERO ============ -->
<section class="hero grain" id="top">
  <svg class="spiral" viewBox="0 0 1000 1000" aria-hidden="true">
    <path
      d="M500 500m-40 0a40 40 0 1 1 80 0a80 80 0 1 1 -160 0a120 120 0 1 1 240 0a160 160 0 1 1 -320 0a200 200 0 1 1 400 0a240 240 0 1 1 -480 0a280 280 0 1 1 560 0a320 320 0 1 1 -640 0a360 360 0 1 1 720 0a400 400 0 1 1 -800 0a440 440 0 1 1 880 0"
    ></path>
    <path d="M500 500m0 -470a470 470 0 1 1 -1 0"></path>
  </svg>
  <div class="wrap">
    <div>
      <p class="kicker">Почтовый клиент «Депеша»</p>
      <h1>
        <span class="line"><span>Входящие,</span></span>
        <span class="line"><span>которые</span></span>
        <span class="line"><span><em>заканчиваются</em></span></span>
      </h1>
      <p class="lede">
        Депеша — почтовый клиент для компьютера, где у каждого письма одна судьба: <b>готово</b>,
        <b>позже</b> или <b>в корзину</b>. Нажали клавишу — и уже открыто следующее.
      </p>
      <div class="cta">
        <a
          class="btn btn-wax"
          href="#download"
          id="cta-main"
          data-linux={linux}
          data-win={win}
          data-mac-arm={macArm}
          data-mac-x64={macX64}><span class="os"
            ><span>Скачать для <span class="os-name">Linux</span></span
            ><small>бесплатно, открытый код</small></span
          ></a
        >
        <a class="btn btn-ghost" href="#story">Посмотреть, как это работает</a>
      </div>
      <div class="fine">
        <span>Linux, Windows, macOS</span><span>Gmail, Яндекс, Exchange и любой IMAP</span>
      </div>
    </div>

    <div class="stage" id="stage">
      <figure class="shot-hero">
        <div class="shot-frame">
          <Picture
            src={mainShot}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            widths={[560, 840, 1280]}
            sizes="(max-width: 900px) 92vw, 620px"
            alt="Окно «Депеши»: слева папки, в середине список входящих с логотипом подтверждённого отправителя, справа открытое письмо «Счёт на оплату»."
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          Депеша{ver}, тема «Чернила»: письмо открыто, у подтверждённого отправителя — логотип.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Название приложения над заголовком: его сверяют с названием на экране согласия. */
  .kicker {
    margin-bottom: 18px;
    font: 500 clamp(14px, 1.1vw, 16px) / 1.2 var(--sans);
    letter-spacing: 0.04em;
    color: var(--accent-hi);
    opacity: 0;
    animation: fade 0.9s var(--ease) 0.35s forwards;
  }
</style>
